<section class="faq-section section-spacing">
  <div class="faq-section__header">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}
      <div class="faq-section__text rte">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  <div class="faq-section__items">
    {% for block in section.blocks %}
      <details class="faq-section__item" {{ block.shopify_attributes }}>
        <summary>
          <span>{{ block.settings.question | escape }}</span>
          <span class="faq-section__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq-section__answer rte">{{ block.settings.answer }}</div>
      </details>
    {% else %}
      {% if request.design_mode %}
        <div class="faq-section__empty">
          Add question blocks to build this FAQ.
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .faq-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  .faq-section__header {
    align-self: start;
    position: sticky;
    top: 2rem;
  }

  .faq-section__header h2 {
    max-width: 10ch;
    margin-top: 0.5rem;
  }

  .faq-section__text {
    margin-top: 1.25rem;
    color: var(--color-muted);
  }

  .faq-section__items {
    border-top: 1px solid var(--color-line);
  }

  .faq-section__item {
    border-bottom: 1px solid var(--color-line);
  }

  .faq-section__item summary {
    min-height: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    cursor: pointer;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    list-style: none;
  }

  .faq-section__item summary::-webkit-details-marker {
    display: none;
  }

  .faq-section__icon {
    width: 1.1rem;
    height: 1.1rem;
    position: relative;
  }

  .faq-section__icon::before,
  .faq-section__icon::after {
    content: '';
    width: 100%;
    height: 1px;
    position: absolute;
    top: 50%;
    left: 0;
    background: currentcolor;
    transition: transform 180ms var(--motion-ease);
  }

  .faq-section__icon::after {
    transform: rotate(90deg);
  }

  .faq-section__item[open] .faq-section__icon::after {
    transform: rotate(0);
  }

  .faq-section__answer {
    padding: 0 3rem 1.5rem 0;
    color: var(--color-muted);
  }

  .faq-section__empty {
    padding: 1.5rem;
    color: var(--color-muted);
    background: var(--color-soft-cream);
    border: 1px dashed var(--color-line);
    border-radius: var(--style-border-radius-inputs);
  }

  @media (max-width: 760px) {
    .faq-section {
      grid-template-columns: 1fr;
    }

    .faq-section__header {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Helpful answers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Everything you need to know before placing your order.</p>"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Add a question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add the answer here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Frequently asked questions",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
