<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <a
        class="site-footer__brand-link"
        href="{{ routes.root_url }}"
        style="--footer-logo-width: {{ section.settings.logo_width }}px"
      >
        {% if section.settings.logo %}
          {{ section.settings.logo
            | image_url: width: section.settings.logo_width
            | image_tag:
              widths: '120, 180, 240, 360, 480',
              width: section.settings.logo_width,
              loading: 'lazy',
              alt: shop.name
          }}
        {% else %}
          {{ section.settings.wordmark | default: shop.name | escape }}
        {% endif %}
      </a>
      {% if section.settings.tagline != blank %}<p>{{ section.settings.tagline | escape }}</p>{% endif %}
      {% if section.settings.show_social %}
        <div class="site-footer__social">
          {% if settings.social_facebook_link != blank %}<a href="{{ settings.social_facebook_link }}">Facebook</a>{% endif %}
          {% if settings.social_instagram_link != blank %}<a href="{{ settings.social_instagram_link }}">Instagram</a>{% endif %}
          {% if settings.social_tiktok_link != blank %}<a href="{{ settings.social_tiktok_link }}">TikTok</a>{% endif %}
        </div>
      {% endif %}
    </div>

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'menu' %}
          <div class="site-footer__menu" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading | escape }}</h2>
            <ul>
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% when 'newsletter' %}
          <div class="site-footer__newsletter" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading | escape }}</h2>
            <p>{{ block.settings.text | escape }}</p>
            {% form 'customer', class: 'site-footer__form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label for="FooterEmail-{{ section.id }}">Email address</label>
              <div>
                <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
                <button class="button" type="submit">{{ block.settings.button_label | escape }}</button>
              </div>
              {% if form.posted_successfully? %}<p role="status">Thanks for joining us.</p>{% endif %}
              {{ form.errors | default_errors }}
            {% endform %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    {% if section.settings.show_payment_icons %}
      <div class="site-footer__payments" aria-label="Accepted payment methods">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    margin-top: clamp(4rem, 9vw, 8rem);
    padding: clamp(3rem, 7vw, 6rem) var(--page-margin) 1.5rem;
    background: var(--color-soft-cream);
    border-top: 1px solid var(--color-line);
  }

  .site-footer__grid,
  .site-footer__bottom {
    width: min(100%, var(--page-width));
    margin-inline: auto;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr 0.7fr 1.4fr;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .site-footer__brand-link {
    width: fit-content;
    max-width: 100%;
    display: block;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .site-footer__brand-link img {
    width: min(var(--footer-logo-width), 100%);
    height: auto;
  }

  .site-footer__brand p,
  .site-footer__newsletter p {
    max-width: 34ch;
    margin-top: 0.8rem;
    color: var(--color-muted);
  }

  .site-footer h2 {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer__social {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .site-footer__form {
    margin-top: 1.25rem;
  }

  .site-footer__form label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .site-footer__form > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
  }

  .site-footer__form input {
    min-width: 0;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    color: var(--color-muted);
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .site-footer__payments svg {
    width: 2.2rem;
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .site-footer__brand,
    .site-footer__newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__form > div,
    .site-footer__bottom {
      grid-template-columns: 1fr;
    }

    .site-footer__bottom {
      display: grid;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 280, "step": 10, "unit": "px", "default": 160 },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Little J’s" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Beautiful smocked clothing for every little occasion." },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": false },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "First look at new arrivals" },
        { "type": "text", "id": "text", "label": "Text", "default": "Occasional notes about fresh drops, preorders, and seasonal favorites." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the list" }
      ]
    }
  ]
}
{% endschema %}
