<section class="cart-page section-spacing">
  <header class="cart-page__header">
    <p class="eyebrow">Your order</p>
    <h1>{{ 'cart.title' | t }}</h1>
    {% if cart.item_count > 0 %}
      <p>{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</p>
    {% endif %}
  </header>

  {% if cart.item_count == 0 %}
    <div class="cart-page__empty">
      <h2>Your bag is ready for something special.</h2>
      <a class="button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-page__layout">
        <div class="cart-page__items">
          {% for item in cart.items %}
            <article class="cart-item">
              <a class="cart-item__media" href="{{ item.url }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 360 | image_tag:
                    widths: '160, 240, 360',
                    sizes: '9rem',
                    loading: 'lazy',
                    alt: item.image.alt
                  }}
                {% endif %}
              </a>
              <div class="cart-item__details">
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
                {% for property in item.properties %}
                  {% assign property_first_character = property.first | slice: 0 %}
                  {% if property.last != blank %}
                    {% unless property_first_character == '_' %}
                      <p>{{ property.first }}: {{ property.last }}</p>
                    {% endunless %}
                  {% endif %}
                {% endfor %}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              </div>
              <div class="cart-item__quantity">
                <label for="Quantity-{{ item.key }}">Quantity</label>
                <input id="Quantity-{{ item.key }}" type="number" name="updates[]" min="0" value="{{ item.quantity }}">
                <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </article>
          {% endfor %}
          <button class="button button--secondary" type="submit">{{ 'cart.update' | t }}</button>
        </div>

        <aside class="cart-summary">
          <h2>Order summary</h2>
          <div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          <p>Taxes and shipping are calculated at checkout.</p>
          <label for="CartNote">Order note</label>
          <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
          <button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          {% if additional_checkout_buttons %}
            <div class="cart-summary__additional">{{ content_for_additional_checkout_buttons }}</div>
          {% endif %}
        </aside>
      </div>
    </form>
  {% endif %}
</section>

{% stylesheet %}
  .cart-page__header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cart-page__header h1 {
    margin-top: 0.6rem;
  }

  .cart-page__header > p:last-child {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .cart-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-top: 3rem;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cart-item__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-inputs);
  }

  .cart-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item h2 {
    font-size: 1rem;
    letter-spacing: 0;
  }

  .cart-item h2 a {
    text-decoration: none;
  }

  .cart-item__details > p:not(.cart-item__price) {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .cart-item__price {
    margin-top: 1rem;
    font-weight: 600;
  }

  .cart-item__quantity {
    display: grid;
    justify-items: end;
    gap: 0.4rem;
  }

  .cart-item__quantity label {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .cart-item__quantity input {
    width: 5rem;
  }

  .cart-item__quantity a {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .cart-page__items > .button {
    margin-top: 1.5rem;
  }

  .cart-summary {
    display: grid;
    gap: 1rem;
    padding: 2rem;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-media);
  }

  .cart-summary h2 {
    font-size: 1.5rem;
  }

  .cart-summary > div:first-of-type {
    display: flex;
    justify-content: space-between;
    padding-block: 1rem;
    border-block: 1px solid var(--color-line);
  }

  .cart-summary > p {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .cart-summary label {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .cart-summary__additional {
    margin-top: 0.5rem;
  }

  .cart-page__empty {
    padding-block: 6rem;
    text-align: center;
  }

  .cart-page__empty h2 {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
  }

  .cart-page__empty .button {
    margin-top: 1.5rem;
  }

  @media (max-width: 800px) {
    .cart-page__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .cart-item {
      grid-template-columns: 6.5rem 1fr;
    }

    .cart-item__quantity {
      grid-column: 2;
      justify-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}

