<section class="not-found section-spacing">
  <p class="eyebrow">{{ '404.title' | t }}</p>
  <h1>That page wandered off.</h1>
  <p>{{ '404.not_found' | t }}</p>
  <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
</section>

{% stylesheet %}
  .not-found {
    padding-block: clamp(7rem, 18vw, 14rem);
    text-align: center;
  }

  .not-found h1 {
    max-width: 11ch;
    margin: 0.75rem auto 0;
  }

  .not-found > p:not(.eyebrow) {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .not-found .button {
    margin-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Not found",
  "settings": []
}
{% endschema %}

