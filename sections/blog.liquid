<section class="blog-page section-spacing">
  <header>
    <p class="eyebrow">From the boutique</p>
    <h1>{{ blog.title | escape }}</h1>
  </header>

  {% paginate blog.articles by 9 %}
    <div class="blog-page__grid">
      {% for article in blog.articles %}
        <article class="article-card">
          {% if article.image %}
            <a class="article-card__media" href="{{ article.url }}">
              {{ article.image | image_url: width: 1200 | image_tag:
                widths: '360, 540, 750, 900, 1200',
                sizes: '(min-width: 900px) 33vw, 100vw',
                loading: 'lazy',
                alt: article.image.alt
              }}
            </a>
          {% endif %}
          {% assign date = article.published_at | time_tag: format: 'date' %}
          <p class="eyebrow">{{ date }}</p>
          <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          {% if article.excerpt != blank %}<div>{{ article.excerpt | strip_html | truncatewords: 24 }}</div>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</section>

{% stylesheet %}
  .blog-page header h1 {
    margin-top: 0.6rem;
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem) clamp(1rem, 3vw, 2.5rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .article-card__media {
    aspect-ratio: 4 / 3;
    display: block;
    overflow: hidden;
    margin-bottom: 1.25rem;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-media);
  }

  .article-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card h2 {
    margin-top: 0.45rem;
    font-size: 1.35rem;
  }

  .article-card h2 a {
    text-decoration: none;
  }

  .article-card > div {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .blog-page__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
