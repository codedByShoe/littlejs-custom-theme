<section class="newsletter-band">
  <div class="newsletter-band__content">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.text | escape }}</p>

    {% form 'customer', class: 'newsletter-band__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email address" autocomplete="email" required>
      <button class="button" type="submit">{{ section.settings.button_label | escape }}</button>
      {% if form.posted_successfully? %}<p class="newsletter-band__status" role="status">Thanks for joining the Little J’s family.</p>{% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .newsletter-band {
    padding: clamp(3rem, 8vw, 7rem);
    background: color-mix(in srgb, var(--color-blue) 22%, var(--color-background));
    border-radius: var(--style-border-radius-media);
    text-align: center;
  }

  .newsletter-band__content {
    max-width: 44rem;
    margin-inline: auto;
  }

  .newsletter-band h2 {
    margin-top: 0.6rem;
  }

  .newsletter-band__content > p:not(.eyebrow) {
    max-width: 44ch;
    margin: 1rem auto 0;
    color: var(--color-muted);
  }

  .newsletter-band__form {
    max-width: 32rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    margin: 2rem auto 0;
    text-align: left;
  }

  .newsletter-band__status,
  .newsletter-band__form .errors {
    grid-column: 1 / -1;
  }

  @media (max-width: 520px) {
    .newsletter-band {
      padding-inline: 1.25rem;
    }

    .newsletter-band__form {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Little J’s Family" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get early access to new collections, preorders, and seasonal favorites." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter band" }]
}
{% endschema %}

