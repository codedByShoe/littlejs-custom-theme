{% assign current_variant = product.selected_or_first_available_variant %}

<article class="product section-spacing">
  <div class="product__media">
    {% for media in product.media %}
      <div class="product__media-item">
        {% case media.media_type %}
          {% when 'image' %}
            {{ media
              | image_url: width: 1800
              | image_tag:
                widths: '480, 750, 1000, 1400, 1800',
                sizes: '(min-width: 900px) 42vw, calc(100vw - 2rem)',
                loading: 'lazy',
                alt: media.alt
            }}
          {% else %}
            {{ media | media_tag }}
        {% endcase %}
      </div>
    {% else %}
      <div class="product__media-item">
        {% render 'product-placeholder', class: 'product__placeholder' %}
      </div>
    {% endfor %}
  </div>

  <div class="product__info">
    {% if product.tags contains 'Preorder' %}
      <p class="product__status">Preorder</p>
    {% elsif product.available %}
      <p class="product__status">Available</p>
    {% else %}
      <p class="product__status">Sold out</p>
    {% endif %}

    <h1>{{ product.title | escape }}</h1>

    <p class="product__price">
      {% if current_variant.compare_at_price > current_variant.price %}
        <span class="price--sale">{{ current_variant.price | money }}</span>
        <s class="price--compare">{{ current_variant.compare_at_price | money }}</s>
      {% else %}
        {{ current_variant.price | money }}
      {% endif %}
    </p>

    {% form 'product', product, class: 'product__form' %}
      {% unless product.has_only_default_variant %}
        <label for="Variant-{{ section.id }}">Choose an option</label>
        <select id="Variant-{{ section.id }}" name="id">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endunless %}

      <label for="Quantity-{{ section.id }}">Quantity</label>
      <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">

      <button class="button product__add" type="submit" {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}Add to bag{% else %}Sold out{% endif %}
      </button>

      {% if section.settings.show_dynamic_checkout and current_variant.available %}
        {{ form | payment_button }}
      {% endif %}
    {% endform %}

    <div class="product__notes">
      {% if product.tags contains 'Preorder' %}
        <details open>
          <summary>Preorder timing</summary>
          <p>{{ section.settings.preorder_text | escape }}</p>
        </details>
      {% endif %}
      <details>
        <summary>Shipping & returns</summary>
        <p>{{ section.settings.shipping_text | escape }}</p>
      </details>
    </div>

    {% if product.description != blank %}
      <div class="product__description rte">{{ product.description }}</div>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .product {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(20rem, 5fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .product__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .product__media-item {
    overflow: hidden;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-media);
  }

  .product__media-item:first-child {
    grid-column: 1 / -1;
  }

  .product__media-item img,
  .product__media-item svg,
  .product__media-item video {
    width: 100%;
    height: auto;
  }

  .product__info {
    position: sticky;
    top: 2rem;
  }

  .product__status {
    margin-bottom: 1rem;
    color: var(--color-rose-dark);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product__info h1 {
    font-size: clamp(2.2rem, 4vw, 4.5rem);
  }

  .product__price {
    display: flex;
    gap: 0.7rem;
    margin-top: 1.25rem;
    font-size: 1.15rem;
  }

  .product__form {
    display: grid;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .product__form label {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .product__form input[type='number'] {
    width: 6rem;
  }

  .product__add {
    width: 100%;
    margin-top: 0.75rem;
  }

  .product__add:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .product__notes {
    margin-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .product__notes details {
    border-bottom: 1px solid var(--color-line);
  }

  .product__notes summary {
    padding-block: 1rem;
    cursor: pointer;
    font-weight: 600;
  }

  .product__notes details p {
    padding-bottom: 1rem;
    color: var(--color-muted);
  }

  .product__description {
    margin-top: 2rem;
    color: var(--color-muted);
  }

  @media (max-width: 800px) {
    .product {
      grid-template-columns: 1fr;
    }

    .product__info {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout", "default": true },
    { "type": "textarea", "id": "preorder_text", "label": "Preorder message", "default": "Estimated ship dates are listed in the product details. In-stock items ordered with preorders may ship together." },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping message", "default": "Ready-to-ship orders are typically packed within 2–3 business days. See our shipping and return policies for details." }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
