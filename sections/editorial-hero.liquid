<section class="editorial-hero section-spacing">
  <div class="editorial-hero__grid">
    <div class="editorial-hero__media">
      {% if section.settings.image %}
        {{ section.settings.image
          | image_url: width: 2200
          | image_tag:
            widths: '640, 900, 1200, 1600, 2200',
            sizes: '(min-width: 990px) 58vw, calc(100vw - 2rem)',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-hero__placeholder' }}
      {% endif %}
    </div>

    <div class="editorial-hero__content">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h1>{{ section.settings.heading | escape }}</h1>
        {% if section.settings.text != blank %}<p class="editorial-hero__intro">{{ section.settings.text | escape }}</p>{% endif %}
      </div>

      <div class="editorial-hero__tiles">
        <a class="editorial-hero__tile editorial-hero__tile--rose" href="{{ section.settings.primary_link }}">
          <span class="eyebrow">{{ section.settings.primary_eyebrow | escape }}</span>
          <strong>{{ section.settings.primary_label | escape }}</strong>
          <span class="editorial-hero__arrow" aria-hidden="true">→</span>
        </a>
        <a class="editorial-hero__tile editorial-hero__tile--sage" href="{{ section.settings.secondary_link }}">
          <span class="eyebrow">{{ section.settings.secondary_eyebrow | escape }}</span>
          <strong>{{ section.settings.secondary_label | escape }}</strong>
          <span class="editorial-hero__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .editorial-hero {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .editorial-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(20rem, 5fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: end;
  }

  .editorial-hero__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-blue) 20%, var(--color-background));
    border-radius: var(--style-border-radius-media);
  }

  .editorial-hero__media img,
  .editorial-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-hero__content {
    display: grid;
    gap: 2rem;
  }

  .editorial-hero__content h1 {
    max-width: 9ch;
  }

  .editorial-hero__intro {
    max-width: 38ch;
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .editorial-hero__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .editorial-hero__tile {
    min-height: 12.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--style-border-radius-media);
    text-decoration: none;
  }

  .editorial-hero__tile--rose {
    background: var(--color-rose);
  }

  .editorial-hero__tile--sage {
    background: var(--color-sage);
  }

  .editorial-hero__tile strong {
    max-width: 8ch;
    margin-top: 1rem;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .editorial-hero__arrow {
    margin-top: auto;
    font-size: 1.8rem;
  }

  @media (max-width: 900px) {
    .editorial-hero__grid {
      grid-template-columns: 1fr;
    }

    .editorial-hero__content h1 {
      max-width: 12ch;
    }
  }

  @media (max-width: 520px) {
    .editorial-hero__tiles {
      gap: 0.75rem;
    }

    .editorial-hero__tile {
      min-height: 10.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Smocked & custom children’s wear" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dressed for Childhood." },
    { "type": "text", "id": "text", "label": "Text", "default": "Thoughtful pieces for everyday play, portraits, and the moments in between." },
    { "type": "text", "id": "primary_eyebrow", "label": "First tile eyebrow", "default": "Collection" },
    { "type": "text", "id": "primary_label", "label": "First tile label", "default": "Shop New Arrivals" },
    { "type": "url", "id": "primary_link", "label": "First tile link" },
    { "type": "text", "id": "secondary_eyebrow", "label": "Second tile eyebrow", "default": "Ongoing" },
    { "type": "text", "id": "secondary_label", "label": "Second tile label", "default": "Current Preorders" },
    { "type": "url", "id": "secondary_link", "label": "Second tile link" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}

