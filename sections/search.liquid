<section class="search-page section-spacing">
  <header class="search-page__header">
    <p class="eyebrow">Find a favorite</p>
    <h1>{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
      <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div class="search-page__empty">
        <h2>No matches yet.</h2>
        <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      </div>
    {% else %}
      <p class="search-page__count">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
      {% paginate search.results by 20 %}
        <div class="search-results">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result, show_badge: true, image_sizes: '(min-width: 990px) 25vw, 50vw' %}
            {% else %}
              <article class="search-result">
                {% assign featured_image = result.featured_image | default: result.image %}
                {% if featured_image %}
                  <a href="{{ result.url }}">
                    {{ featured_image | image_url: width: 900 | image_tag:
                      widths: '360, 540, 750, 900',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      loading: 'lazy',
                      alt: featured_image.alt
                    }}
                  </a>
                {% endif %}
                <p class="eyebrow">{{ result.object_type }}</p>
                <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>

{% stylesheet %}
  .search-page__header {
    max-width: 60rem;
  }

  .search-page__header h1 {
    margin-top: 0.6rem;
  }

  .search-page__header form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .search-page__count {
    margin-top: 3rem;
    padding-block: 1rem;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-line);
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: 4rem;
    padding-top: 3rem;
  }

  .search-result > a {
    aspect-ratio: 4 / 5;
    display: block;
    overflow: hidden;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-media);
  }

  .search-result img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-result .eyebrow {
    margin-top: 1rem;
  }

  .search-result h2 {
    margin-top: 0.35rem;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .search-result h2 a {
    text-decoration: none;
  }

  .search-page__empty {
    padding-block: 6rem;
  }

  .search-page__empty h2 {
    font-size: 2rem;
  }

  @media (max-width: 760px) {
    .search-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .search-page__header form {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
