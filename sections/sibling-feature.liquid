<section class="sibling-feature section-spacing">
  <div class="sibling-feature__copy">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    <a class="button" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
  </div>

  <div class="sibling-feature__media">
    <div>
      {% if section.settings.first_image %}
        {{ section.settings.first_image | image_url: width: 1100 | image_tag:
          widths: '360, 540, 750, 900, 1100',
          sizes: '(min-width: 990px) 30vw, 50vw',
          loading: 'lazy',
          alt: section.settings.first_image.alt
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="sibling-feature__media-offset">
      {% if section.settings.second_image %}
        {{ section.settings.second_image | image_url: width: 1100 | image_tag:
          widths: '360, 540, 750, 900, 1100',
          sizes: '(min-width: 990px) 30vw, 50vw',
          loading: 'lazy',
          alt: section.settings.second_image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .sibling-feature {
    display: grid;
    grid-template-columns: minmax(16rem, 5fr) minmax(0, 7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .sibling-feature__copy h2 {
    max-width: 10ch;
    margin-top: 0.7rem;
  }

  .sibling-feature__copy .rte {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .sibling-feature__copy .button {
    margin-top: 2rem;
  }

  .sibling-feature__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .sibling-feature__media > div {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-media);
  }

  .sibling-feature__media img,
  .sibling-feature__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sibling-feature__media-offset {
    margin-top: 3rem;
  }

  @media (max-width: 760px) {
    .sibling-feature {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sibling feature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to coordinate" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sibling Sets Made Simple" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Matching moments, without the guesswork. Shop coordinated colors and smocking for brothers and sisters.</p>" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop matching sets" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "first_image", "label": "First image" },
    { "type": "image_picker", "id": "second_image", "label": "Second image" }
  ],
  "presets": [{ "name": "Sibling feature" }]
}
{% endschema %}

