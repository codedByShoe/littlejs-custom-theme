{% doc %}
  Renders the document title, canonical URL, search metadata, social sharing
  cards, and page-appropriate JSON-LD structured data.

  @example
  {% render 'meta-tags' %}
{% enddoc %}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="{{ settings.background_color }}">

{%- liquid
  assign meta_title = page_title | default: shop.name
  assign meta_url = canonical_url | default: request.origin
  assign meta_description = page_description | default: shop.description | default: shop.name
  assign meta_type = 'website'
  assign social_image = page_image | default: settings.social_sharing_image

  if request.page_type == 'product'
    assign meta_type = 'product'
  elsif request.page_type == 'article'
    assign meta_type = 'article'
  elsif request.page_type == 'password'
    assign meta_url = request.origin
  endif

  capture full_title
    echo meta_title
    if current_tags
      echo ' — tagged "'
      echo current_tags | join: ', '
      echo '"'
    endif
    if current_page != 1
      echo ' — Page '
      echo current_page
    endif
    unless meta_title contains shop.name
      echo ' — '
      echo shop.name
    endunless
  endcapture
-%}

<title>Little J's Children's Boutique | {{ page_title }}</title>
<link rel="canonical" href="{{ meta_url }}">
<meta name="description" content="{{ meta_description | strip_html | strip_newlines | escape_once }}">

<meta property="og:site_name" content="{{ shop.name | escape_once }}">
<meta property="og:url" content="{{ meta_url }}">
<meta property="og:title" content="{{ meta_title | escape_once }}">
<meta property="og:type" content="{{ meta_type }}">
<meta property="og:description" content="{{ meta_description | strip_html | strip_newlines | escape_once }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{% if social_image %}
  <meta property="og:image" content="https:{{ social_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ social_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ social_image.width }}">
  <meta property="og:image:height" content="{{ social_image.height }}">
  <meta property="og:image:alt" content="{{ social_image.alt | default: meta_title | escape_once }}">
{% endif %}

{% if request.page_type == 'product' %}
  {% assign current_variant = product.selected_or_first_available_variant %}
  <meta property="product:price:amount" content="{{ current_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta
    property="product:availability"
    content="{% if current_variant.available %}in stock{% else %}out of stock{% endif %}"
  >
{% elsif request.page_type == 'article' %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {% for tag in article.tags %}
    <meta property="article:tag" content="{{ tag | escape_once }}">
  {% endfor %}
{% endif %}

<meta name="twitter:card" content="{% if social_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ meta_title | escape_once }}">
<meta name="twitter:description" content="{{ meta_description | strip_html | strip_newlines | escape_once }}">
{% if social_image %}
  <meta name="twitter:image" content="https:{{ social_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ social_image.alt | default: meta_title | escape_once }}">
{% endif %}

{% if request.page_type == 'product' %}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{% elsif request.page_type == 'article' %}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{% endif %}

{% if request.page_type == 'index' %}
  {%- assign organization_logo = settings.social_sharing_image -%}
  {%- capture search_url_template -%}
    {{- shop.url -}}{{- routes.search_url -}}?q={search_term_string}
  {%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ shop.url | append: '#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }}{% if organization_logo %},
          "logo": {
            "@type": "ImageObject",
            "url": {{ organization_logo | image_url: width: 600 | prepend: 'https:' | json }},
            "width": {{ organization_logo.width | json }},
            "height": {{ organization_logo.height | json }}
          }{% endif %}
        },
        {
          "@type": "WebSite",
          "@id": {{ shop.url | append: '#website' | json }},
          "url": {{ shop.url | json }},
          "name": {{ shop.name | json }},
          "publisher": {
            "@id": {{ shop.url | append: '#organization' | json }}
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": {{ search_url_template | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{% endif %}

{% liquid
  assign show_breadcrumbs = false
  if request.page_type == 'product'
    assign show_breadcrumbs = true
  elsif request.page_type == 'collection'
    assign show_breadcrumbs = true
  elsif request.page_type == 'article'
    assign show_breadcrumbs = true
  elsif request.page_type == 'blog'
    assign show_breadcrumbs = true
  elsif request.page_type == 'page'
    assign show_breadcrumbs = true
  endif
%}

{% if show_breadcrumbs %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | append: routes.root_url | json }}
        }
        {% if request.page_type == 'product' %}
          {% assign breadcrumb_collection = collection | default: product.collections.first %}
          {% if breadcrumb_collection %},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ breadcrumb_collection.title | json }},
              "item": {{ shop.url | append: breadcrumb_collection.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ canonical_url | json }}
            }
          {% else %},
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ canonical_url | json }}
            }
          {% endif %}
        {% elsif request.page_type == 'collection' %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ canonical_url | json }}
          }
        {% elsif request.page_type == 'article' %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ shop.url | append: blog.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ canonical_url | json }}
          }
        {% elsif request.page_type == 'blog' %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ canonical_url | json }}
          }
        {% elsif request.page_type == 'page' %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ canonical_url | json }}
          }
        {% endif %}
      ]
    }
  </script>
{% endif %}
