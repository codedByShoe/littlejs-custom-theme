{% doc %}
  Renders a lightweight product card.

  @param {product} product - Product to render.
  @param {boolean} [show_badge] - Whether to show availability or preorder status.
  @param {string} [image_sizes] - Responsive sizes attribute.

  @example
  {% render 'product-card', product: product, show_badge: true %}
{% enddoc %}

{% liquid
  assign card_badge = blank
  if show_badge
    if product.available == false
      assign card_badge = 'Sold out'
    elsif product.tags contains 'Preorder'
      assign card_badge = 'Preorder'
    elsif product.tags contains 'Ready to ship'
      assign card_badge = 'Ready to ship'
    endif
  endif
%}

<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}">
    {% if product.featured_image %}
      {{ product.featured_image
        | image_url: width: 900
        | image_tag:
          widths: '240, 360, 480, 640, 750, 900',
          sizes: image_sizes,
          loading: 'lazy',
          alt: product.featured_image.alt
      }}
    {% else %}
      {% render 'product-placeholder', class: 'product-card__placeholder' %}
    {% endif %}
  </a>

  <div class="product-card__details">
    {% if card_badge != blank %}<p class="product-card__badge">{{ card_badge }}</p>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <p class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="price--sale">{{ product.price | money }}</span>
        <s class="price--compare">{{ product.compare_at_price | money }}</s>
      {% else %}
        {% if product.price_varies %}From {% endif %}{{ product.price | money }}
      {% endif %}
    </p>
  </div>
</article>

{% stylesheet %}
  .product-card {
    min-width: 0;
  }

  .product-card__media {
    aspect-ratio: 4 / 5;
    display: block;
    overflow: hidden;
    background: var(--color-soft-cream);
    border-radius: var(--style-border-radius-media);
  }

  .product-card__media img,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__details {
    padding-top: 1rem;
  }

  .product-card__badge {
    margin-bottom: 0.35rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card h3 {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .product-card h3 a {
    text-decoration: none;
  }

  .product-card__price {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.95rem;
  }
{% endstylesheet %}
